# Copied to .factory/env by scripts/bootstrap.sh with real secrets generated.
# Never commit .factory/env.
PAK_PORT=8787
WAKE_PORT=8788
WAKE_URL=http://localhost:8788
PAK_URL=http://localhost:8787
# host runs the Agent SDK host; cli falls back to the interactive Claude Code session
# and is kept working while the host beds in.
PLANNER_MODE=host
# The Planner host's local health port.
PLANNER_HOST_PORT=8789
# How often the host posts its own liveness heartbeat to the Pak, in seconds; 0 disables it.
PLANNER_HOST_HEARTBEAT_SECONDS=120
# Optional: mint with `claude setup-token`; valid for a year and lets the host keep working across
# logouts. When empty, the host uses the machine's own `claude` login, which is the normal case.
# This is a credential: put it only in .factory/env and never commit it.
CLAUDE_CODE_OAUTH_TOKEN=
# The host writes its resumable session id to .factory/planner-session.json. The file is created
# automatically; deleting it simply makes the next start a fresh Planner session instead of resuming.
# Address the phone reaches the Pak on; notification tap-through is omitted while empty.
PAK_PUBLIC_URL=https://macbook-pro-6.taild72c8d.ts.net
WAKE_SECRET=replace-me
GH_WEBHOOK_SECRET=replace-me
# Pushes are disabled while NTFY_URL is empty.
NTFY_PORT=8790
NTFY_URL=http://localhost:8790
NTFY_TOPIC=wyld-pak
